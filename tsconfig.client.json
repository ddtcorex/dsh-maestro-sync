{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "lib",
    "outDir": "lib",
    "rootDir": "src/client",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": ["src/client/**/*"],
  "exclude": ["lib", "node_modules"]
}
